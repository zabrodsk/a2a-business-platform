{
  "name": "@pneu007/relay",
  "private": true,
  "type": "module",
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "kysely": "^0.29.6"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env -e \"const p=process.env.DB_PATH||'data/relay.db';require('fs').mkdirSync(require('path').dirname(p),{recursive:true});require('child_process').execFileSync('npx',['a2a-db','upgrade','--url','sqlite:'+p],{stdio:'inherit'})\"",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  }
}