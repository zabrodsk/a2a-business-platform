# Copy to .env (git-ignored) and fill in. Tokens: >= 16 chars, e.g. `openssl rand -hex 24`.
PORT=8787
BUSINESS_PROFILE=pneu007                      # profiles/<id>.json shown on the public card (pneu007 | icecream)
PUBLIC_URL=https://relay.example.com          # public origin; card is served at /.well-known/agent-card.json
# A2A_ENDPOINT_URL=https://relay.example.com/a2a/jsonrpc   # override to test an endpoint move (T15)
DB_PATH=data/relay.db                         # must be on a persistent disk
CUSTOMER_TOKENS=customer-a:CHANGE_ME          # comma-separated <id>:<token>
# Explicit sandbox opt-in; only A2A conversations become public. Business tools stay private.
DEMO_PUBLIC_A2A=false
# Unified fictional Pneu installation only: exact-offer chat consent and local simulated funding.
DEMO_CHAT_APPROVAL=false
# Prepared unified Pneu shop: public business tools with no owner onboarding.
DEMO_OPEN_BUSINESS=false
BUSINESS_TOKEN=CHANGE_ME
BUSINESS_ID=garage-demo
ADMIN_TOKEN=CHANGE_ME
# Business GrokBot webhook routine (doorbell). Leave empty to run in polling mode.
BUSINESS_WEBHOOK_URL=
BUSINESS_WEBHOOK_KEY=
PUSH_HOST_ALLOWLIST=api2.cursor.sh            # hosts customers may register for A2A push
REPLY_WAIT_MS=900000
MAX_AGENT_TURNS=10
