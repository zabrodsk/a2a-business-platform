        <mxCell id="enforce" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b style=&quot;font-size:21px&quot;&gt;Backend vynucuje pravidla&lt;/b&gt;&lt;div style=&quot;margin-top:12px;line-height:1.25&quot;&gt;Agent může pravidlo navrhnout,&lt;br&gt;ale nemůže je sám aktivovat.&lt;br&gt;SKILL.md sám oprávnění nevynucuje.&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;sketch=1;comic=0;jiggle=1.4;curveFitting=1;fillStyle=solid;fontFamily=Comic Sans MS;fontColor=#293C34;shape=rectangle;rounded=1;arcSize=12;strokeWidth=2;fillColor=#EEE6F8;strokeColor=#8972A4;fontSize=18;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
