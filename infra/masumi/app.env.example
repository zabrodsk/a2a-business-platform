# Merge these server-only entries into the application's local environment.
PAYMENT_PROVIDER=masumi
MASUMI_NETWORK=Preprod
# Explicit operator permission to perform the first controlled Preprod smoke purchase.
# Enabling this does not mark live verification PASS.
MASUMI_ENABLE_PREPROD_PURCHASES=false
MASUMI_PAYMENT_SERVICE_URL=http://127.0.0.1:3001/api/v1
MASUMI_BUYER_SERVICE_URL=http://127.0.0.1:3002/api/v1
# Explicit localhost-only HTTP opt-in for these mapped ports; remote nodes require HTTPS.
MASUMI_ALLOW_LOCAL_HTTP=true
MASUMI_PAYMENT_API_KEY=
MASUMI_BUYER_API_KEY=
MASUMI_SELLER_VKEY=
# Server-only read credential for independent confirmed payout verification.
MASUMI_BLOCKFROST_PROJECT_ID=
# Optional explicit collection destination; defaults to the seller wallet.
MASUMI_COLLECTION_ADDRESS=
# JSON mapping of only registered FIXED SKU agent identifiers, not amounts.
MASUMI_SKUS={}
MASUMI_TIMEOUT_MS=10000
# Recommended human checkout fee budget in lovelace, explicitly accepted at checkout.
# Default 2000000; a controlled 20 test-ADA wallet with a 5 test-ADA SKU
# requires 15000000 to bound the remaining 15 test-ADA exposure. This is not
# the actual network fee and does not override an agent mandate or enable purchases.
MASUMI_CHECKOUT_NETWORK_FEE=2000000
# Leave false until an isolated single-wallet buyer node is verified.
MASUMI_DEDICATED_BUYER_WALLET=false
MASUMI_BUYER_WALLET_ADDRESS=
# Set true only after externally ensuring exclusive lifecycle ownership:
# no other clients, no second process, no deposits/top-ups until payout/refund final.
# This declaration is not a cryptographic or automatic fee enforcement proof.
MASUMI_BUYER_LIFECYCLE_ISOLATED=false
