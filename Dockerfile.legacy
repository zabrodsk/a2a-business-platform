# Independent legacy business and unified A2A transport. Does not replace the existing relay image.
FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/legacy/package.json apps/legacy/package.json
COPY apps/relay/package.json apps/relay/package.json
COPY packages/agent-client/package.json packages/agent-client/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/demo-garage/package.json packages/demo-garage/package.json
COPY packages/audit/package.json packages/audit/package.json
COPY packages/payments/package.json packages/payments/package.json
RUN npm ci --no-audit --no-fund
COPY apps/legacy apps/legacy
COPY apps/relay apps/relay
COPY packages/agent-client packages/agent-client
COPY packages/contracts packages/contracts
COPY packages/demo-garage packages/demo-garage
COPY packages/audit packages/audit
COPY packages/payments packages/payments
COPY fixtures fixtures
COPY prompts prompts
RUN npm run typecheck && npm run build
ENV NODE_ENV=production LEGACY_HOST=0.0.0.0 LEGACY_DB_PATH=/data/legacy.db LEGACY_RELAY_DB_PATH=/data/legacy-relay.db
CMD ["node", "--import", "tsx", "apps/legacy/src/system.ts"]
